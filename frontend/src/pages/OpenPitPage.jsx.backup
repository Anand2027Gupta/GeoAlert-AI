import { useState } from 'react'

const SECTORS = [
  'Sector 4 — North Bench Wall (Highwall C)',
  'Sector 2 — South Bench Wall',
  'Sector 7 — East Pit Crest',
  'Sector 1 — West Access Ramp',
]

const PARAMS = [
  { label: 'Bench Angle', id: 'bench-angle', unit: '°', default: 68, min: 45, max: 80 },
  { label: 'Slope Height', id: 'slope-height', unit: 'm', default: 45, min: 20, max: 120 },
  { label: 'Pit Slope', id: 'pit-slope', unit: '°', default: 42, min: 30, max: 60 },
  { label: 'RMR Rating', id: 'rmr-rating', unit: '', default: 48, min: 20, max: 90 },
  { label: 'GSI Index', id: 'gsi-index', unit: '', default: 52, min: 20, max: 90 },
  { label: 'Joint Spacing', id: 'joint-spacing', unit: 'm', default: 0.35, min: 0.1, max: 2.0, step: 0.05 },
  { label: 'GW Depth', id: 'gw-depth', unit: ' m', default: 18, min: 5, max: 50 },
  { label: 'Precip 24h', id: 'precip-24h', unit: 'mm', default: 28.4, min: 0, max: 100 },
  { label: 'Blast PPV', id: 'blast-ppv', unit: 'mm/s', default: 14.2, min: 0, max: 50 },
]

export default function OpenPitPage() {
  const [selectedSector, setSelectedSector] = useState(SECTORS[0])
  const [showDropdown, setShowDropdown] = useState(false)
  const [params, setParams] = useState(
    Object.fromEntries(PARAMS.map(p => [p.id, p.default]))
  )
const [fs, setFs] = useState(1.5)
const [reinforcement, setReinforcement] = useState(2.0)
  const [inferenceResult, setInferenceResult] = useState(null)
const API_BASE_URL = import.meta.env.VITE_API_BASE_URL || 'http://127.0.0.1:8000' 
const runInference = () => {
    setIsComputing(true)
    setInferenceResult(null)
    fetchPrediction(fs, reinforcement).then((result) => {
      setIsComputing(false)
      if (result.success) {
        setInferenceResult({
          fs: result.data.fs,
          reinforcement: result.data.reinforcement,
          risk: result.data.risk_level === 'High' ? 'High' : 'Low',
          riskLevel: result.data.risk_level,
          riskMessage: result.data.message
        })
      } else {
        setInferenceResult({
          fs: fs,
          reinforcement: reinforcement,
          risk: 'Error',
          riskLevel: 'Error',
          riskMessage: result.error || 'Failed to get prediction'
        })
      }
    })
  }
  

const fetchPrediction = async (fs, reinforcement) => {
  try {
    const response = await fetch(`${API_BASE_URL}/predict`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        mine_type: 'open-pit',
        open_pit: { fs, reinforcement }
      }),
    })
    
    if (!response.ok) {
      throw new Error(`Server error: ${response.status}`)
    }
    
    const data = await response.json()
    return { success: true, data }
  } catch (error) {
    return { success: false, error: error.message || 'Network error' }
  }
}
  const [isComputing, setIsComputing] = useState(false)

const runInference = () => {
    setIsComputing(true)
    setInferenceResult(null)
    fetchPrediction(fs, reinforcement).then((result) => {
      setIsComputing(false)
      if (result.success) {
        setInferenceResult({
          fs: result.data.fs,
          reinforcement: result.data.reinforcement,
          risk: result.data.risk_level === 'High' ? 'High' : 'Low',
          riskLevel: result.data.risk_level,
          riskMessage: result.data.message
        })
      } else {
        setInferenceResult({
          fs: fs,
          reinforcement: reinforcement,
          risk: 'Error',
          riskLevel: 'Error',
          riskMessage: result.error || 'Failed to get prediction'
        })
      }
    })
  }
  const runInference = () => {
    setIsComputing(true)
    setInferenceResult(null)

    fetchPrediction(fs, reinforcement).then((result) => {
      setIsComputing(false)
      if (result.success) {
        setInferenceResult({
          fs: result.data.fs,
          reinforcement: result.data.reinforcement,
          risk: result.data.risk_level === 'High' ? 'High' : 'Low',
          riskLevel: result.data.risk_level,
          riskMessage: result.data.message
        })
      } else {
        setInferenceResult({
          fs: fs,
          reinforcement: reinforcement,
          risk: 'Error',
          riskLevel: 'Error',
          riskMessage: result.error || 'Failed to get prediction'
        })
      }
    })
  }

  return (
    <div className="flex flex-col w-full px-gutter py-space-sm space-y-space-md max-w-7xl mx-auto">
      <div className="flex flex-col gap-space-xs bg-surface-container-low p-space-md rounded-lg shadow-sm">
        <div className="flex flex-wrap items-center justify-between gap-space-sm">
          <div className="flex items-center gap-space-sm">
            <span className="p-1.5 rounded bg-primary-container/20 text-primary-container flex items-center justify-center">
              <span className="material-symbols-outlined text-[20px]">landscape</span>
            </span>
            <div>
              <h1 className="scada-page-title">Open-Pit Geotechnical Monitoring</h1>
              <p className="scada-page-subtitle">Bench Slope Stability, InSAR Radar & Pit Crest Dynamics</p>
            </div>
          </div>
          <div className="relative">
            <button
              className="flex items-center gap-2 px-space-md py-1.5 rounded bg-surface-container-high hover:bg-surface-container-highest text-on-surface transition-colors"
              onClick={() => setShowDropdown(!showDropdown)}
            >
              <span className="w-2 h-2 rounded-full bg-primary-container animate-pulse" />
              <span className="font-label-md text-label-md tracking-wide uppercase">{selectedSector}</span>
              <span className="material-symbols-outlined text-[16px] text-secondary">expand_more</span>
            </button>
            {showDropdown && (
              <div className="absolute right-0 mt-1 w-72 bg-surface-container-highest shadow-xl rounded-lg z-30 p-1 space-y-0.5">
                <div className="px-space-sm py-1 font-label-sm text-label-sm text-on-surface-variant uppercase">Select Open-Pit Zone</div>
                {SECTORS.map(s => (
                  <button
                    key={s}
                    onClick={() => { setSelectedSector(s); setShowDropdown(false) }}
                    className="w-full text-left px-space-sm py-1.5 rounded bg-surface-container text-primary font-label-md text-label-md flex items-center justify-between"
                  >
                    {s}
                  </button>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-space-md">
        <div className="lg:col-span-2">
          <div className="scada-card-elevated">
            <h3 className="font-label-md text-label-md text-on-surface mb-space-md">Geotechnical Inference Parameters</h3>
            <div className="grid grid-cols-1 sm:grid-cols-3 gap-space-sm">
              {PARAMS.map(p => (
                <div key={p.id} className="flex flex-col gap-space-xs">
                  <label className="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">{p.label}</label>
                  <div className="flex items-end gap-space-xs">
                    <input
                      type="range"
                      min={p.min}
                      max={p.max}
                      step={p.step || 1}
                      value={params[p.id]}
                      onChange={(e) => setParams({ ...params, [p.id]: e.target.value })}
                      className="w-full h-1 bg-surface-container-high rounded-lg appearance-none cursor-pointer accent-primary"
                    />
                    <span className={`font-label-md text-label-md font-mono ${params[p.id] > 70 ? 'text-[#EF4444]' : 'text-on-surface'}`}>
                      {params[p.id]}{p.unit}
                    </span>
                  </div>
                </div>
              ))}
            </div>
            <div className="mt-space-md">
              <button
                className="scada-btn-primary w-full"
                onClick={runInference}
                disabled={isComputing}
              >
                {isComputing ? (
                  <div>
                    <span className="material-symbols-outlined text-[20px] animate-spin">sync</span>
<div className="scada-card-elevated mb-space-md">
  <h3 className="font-label-md text-label-md text-on-space mb-space-sm">Prediction Result</h3>
  {inferenceResult ? (
    <div className="p-4 rounded-lg border border-outline/30">
      <p className="font-medium text-on-space mb-2">Risk Level: <span className={`text-${inferenceResult.riskLevel === 'High' ? 'F59E0B' : '22C55E'}`}>{inferenceResult.risk}</span></p>
      <p className="text-[11px] text-on-surface-variant mt-1">{inferenceResult.riskMessage}</p>
      <p className="text-[10px] text-on-surface-variant mt-2">fs: {inferenceResult.fs}, reinforcement: {inferenceResult.reinforcement}</p>
    </div>
  ) : (
    </div>
  )
}
                ) : (
                  <>
                    </span className="material-symbols-outlined text-[20px]">smart_toy</span>
                    <span>Run Open-Pit Hazard Inference</span>
                  </div>
                )}
              </button>
            </div>
            {inferenceResult && (
              <div className="mt-space-md p-space-md rounded bg-surface-container-high border border-primary/30">
                <h4 className="font-label-md text-label-md text-primary mb-space-sm">Inference Result</h4>
                <div className="grid grid-cols-2 gap-space-sm">
                  <div>
                    <span className="font-label-sm text-label-sm text-on-surface-variant">Factor of Safety</span>
                    <span className="font-body-md text-body-md text-on-surface">{inferenceResult.fs}</span>
                  </div>
                  <div>
                    <span className="font-label-sm text-label-sm text-on-surface-variant">Reinforcement</span>
                    <span className="font-body-md text-body-md text-on-surface">{inferenceResult.reinforcement}</span>
                  </div>
                </div>
                <p className="mt-space-sm font-label-sm text-label-sm text-on-surface-variant">
                  Risk Level: <span className="text-[#F59E0B] font-bold">{inferenceResult.risk}</span>
                </p>
                <p className="font-body-sm text-[11px] text-on-surface-variant mt-space-xs">
                  Risk model is local — backend must be running for inference.
                </p>
              </div>
            )}
          </div>
        </div>
        <div className="lg:col-span-1">
          <div className="scada-card-elevated mb-space-md">
            <h3 className="font-label-md text-label-md text-on-surface mb-space-sm">Active Alerts</h3>
            <div className="space-y-space-xs">
              {[
                { type: 'Critical', msg: 'Slope displacement rate increased 12%', time: '14:18' },
                { type: 'Warning', msg: 'InSAR coherence loss detected', time: '13:42' },
                { type: 'Info', msg: 'Radar calibration complete', time: '12:11' },
              ].map((a, i) => (
                <div key={i} className="flex items-center justify-between p-space-xs rounded bg-surface-container-high border border-outline/50">
                  <span className={`font-label-sm text-label-sm font-mono ${a.type === 'Critical' ? 'text-[#EF4444]' : a.type === 'Warning' ? 'text-[#F59E0B]' : 'text-[#7bd0ff]'}`}>
                    {a.type}
                  </span>
                  <div className="flex flex-col items-end">
                    <span className="font-body-sm text-[11px] text-on-surface">{a.msg}</span>
                    <span className="font-label-sm text-[9px] text-on-surface-variant">{a.time}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div className="scada-card">
            <h3 className="font-label-md text-label-md text-on-surface mb-space-sm">Dispatch Alert</h3>
            <button
              className="scada-btn-error w-full mt-space-sm"
              onClick={() => alert('Dispatch alert sent (demo mode)')}
            >
              <span className="material-symbols-outlined text-[14px]">send</span>
              <span>Transmit Dispatch</span>
            </button>
          </div>

          <div className="scada-card mt-space-md">
            <h3 className="font-label-md text-label-md text-on-surface mb-space-sm">Telemetry Vector</h3>
            <div className="space-y-space-xs">
              {['dX', 'dY', 'dZ', 'Velocity'].map((v, i) => (
                <div key={v} className="flex items-center justify-between p-space-xs rounded bg-surface-container-high">
                  <span className="font-label-sm text-label-sm text-on-surface-variant">{v}</span>
                  <span className={`font-label-md text-label-md font-mono ${i === 0 ? 'text-[#EF4444]' : 'text-on-surface'}`}>
                    {i === 0 ? '+12.4 mm/h' : i === 1 ? '-3.2 mm/h' : i === 2 ? '+0.8 mm/h' : '4.2 mm/h'}
                  </span>
                  <span className={`material-symbols-outlined text-[14px] ${i === 0 ? 'text-[#EF4444]' : 'text-[#22C55E]'}`}>
                    {i === 0 ? 'trending_up' : i === 1 ? 'trending_down' : 'trending_up'}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  )
}